    "type": "git",
    "url": "git+https://github.com/joe-purramid/highgear.git"
  },
  "bugs": {
    "url": "https://github.com/joe-purramid/highgear/issues"
  },
  "homepage": "https://github.com/joe-purramid/highgear#readme",
  "devDependencies": {
    "@11ty/eleventy": "^3.1.7",
    "@11ty/eleventy-img": "^6.0.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/limelight": "^5.3.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
