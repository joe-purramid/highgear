{
  "name": "highgear",
  "version": "1.0.0",
  "description": "Website for High Gear, a women’s barbershop quartet from Nashua, NH",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "eleventy --serve",
    "build": "eleventy",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\""
